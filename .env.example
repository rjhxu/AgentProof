# Copy to .env (never commit .env)

# Claude API key - https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Model used by the shopping agents, verifier narration, and diagnosis
AGENTPROOF_MODEL=claude-opus-5-5

# Service ports (defaults shown)
WEB_PORT=3000
RUNNER_PORT=4000
STOREFRONT_PORT=5000

# The dashboard talks to the runner here
NEXT_PUBLIC_RUNNER_URL=http://localhost:4000

# Where runs, screenshots, and traces are written (relative to repo root)
AGENTPROOF_DATA_DIR=./data

# Comma-separated list of hosts the browser agent is allowed to visit.
# Keep this to the synthetic storefront for the hackathon.
AGENTPROOF_ALLOWED_HOSTS=localhost,127.0.0.1

# Hard cap on agent steps per run
AGENTPROOF_MAX_STEPS=25

# Set to 1 to run Playwright headed (useful for OBS recording)
PLAYWRIGHT_HEADED=0
