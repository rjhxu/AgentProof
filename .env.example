# Copy to .env (never commit .env)

# ---- LLM provider -------------------------------------------------------------
# The team key is an Anthropic key (switched from xAI on 2026-10-17; the xAI account had no credits).
ANTHROPIC_API_KEY=sk-ant-...
# To use xAI Grok instead, set one of these (an xAI key takes precedence over the Anthropic key):
# GROK_API_KEY=xai-...
# XAI_API_KEY=xai-...
# Force a provider instead of auto-detecting from the keys above: xai | anthropic
# AGENTPROOF_LLM_PROVIDER=anthropic
# xAI endpoint mode: responses (default, recommended by xAI) | chat (legacy OpenAI-compatible)
# XAI_API_MODE=responses
# xAI endpoint root, for a gateway or proxy in front of api.x.ai (the adapter appends /responses)
# XAI_BASE_URL=https://api.x.ai/v1

# ---- Models (defaults live in packages/agent/src/profiles.ts) ------------------
# Tiered by design: the cheap text-only agent must be able to shop the store.
# Cost rule: cheapest model everywhere, Sonnet only for Sigma. Anthropic defaults shown; xAI
# defaults are grok-4.3 (Alpha, Beta, mission, diagnosis), grok-4.7 (Sigma), grok-4.20-0309-non-reasoning (narrator).
# AGENTPROOF_MODEL_ALPHA=claude-haiku-5-5        # semantic agent, text only, low effort
# AGENTPROOF_MODEL_BETA=claude-sonnet-5-5        # vision agent, screenshots
# AGENTPROOF_MODEL_SIGMA=claude-sonnet-5-5       # hybrid reference agent, strongest we allow
# AGENTPROOF_MODEL_NARRATOR=claude-haiku-5-5     # report narratives
# AGENTPROOF_MODEL_MISSION=claude-haiku-5-5      # mission generator
# AGENTPROOF_MODEL_DIAGNOSIS=claude-haiku-5-5    # diagnosis in packages/diagnostics
# AGENTPROOF_MODEL_CODEFIX=claude-haiku-5-5      # code-fix agent: diagnosis + edits proposal (docs/CODEFIX.md)
# AGENTPROOF_MODEL_REVIEW=claude-haiku-5-5       # code-fix agent: advisory review of the diff; Sonnet recommended
# Override every role at once:
# AGENTPROOF_MODEL=claude-haiku-5-5

# ---- GitHub App (the runner's identity for private repos and draft pull requests) ----------------
# Register with one click at http://localhost:4000/github/app/setup: the runner writes these lines into .env
# itself (and makes the file owner-only). Share .env with teammates out of band; the key never leaves the runner.
# AGENTPROOF_GITHUB_APP_ID=123456
# AGENTPROOF_GITHUB_APP_PRIVATE_KEY_FILE=/absolute/path/to/agentproof.private-key.pem
# AGENTPROOF_GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# AGENTPROOF_GITHUB_APP_SLUG=agentproof-ab12

# ---- Services -------------------------------------------------------------------
WEB_PORT=3000
RUNNER_PORT=4000
# macOS usually holds 5000 (AirPlay); use 5050 there and keep STOREFRONT_URL in sync.
STOREFRONT_PORT=5000
STOREFRONT_URL=http://localhost:5000
NEXT_PUBLIC_RUNNER_URL=http://localhost:4000

# Where runs, screenshots, traces, and reports are written (relative to repo root)
AGENTPROOF_DATA_DIR=./data

# Comma-separated list of hosts the browser agents may visit. Keep it to the synthetic store.
AGENTPROOF_ALLOWED_HOSTS=localhost,127.0.0.1

# Hard cap on agent steps per run (profiles may set lower caps per agent)
AGENTPROOF_MAX_STEPS=25

# Set to 1 to run Playwright headed (useful for OBS recording)
PLAYWRIGHT_HEADED=0

# Set to 1 to print one line per model call (model, blocks, tokens; never keys or image data)
# AGENTPROOF_LLM_DEBUG=0

# Set to 1 to print stack traces on CLI internal errors (pnpm cli)
# AGENTPROOF_DEBUG=0
