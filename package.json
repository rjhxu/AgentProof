{
  "name": "agentproof",
  "private": true,
  "version": "0.1.0",
  "description": "The testing ground for AI-powered commerce. DubHacks 2026 - Visa Reimagine Shopping.",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @agentproof/web dev",
    "dev:runner": "pnpm --filter @agentproof/runner dev",
    "dev:store": "pnpm --filter @agentproof/storefront dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "playwright:install": "pnpm --filter @agentproof/agent exec playwright install chromium"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
