{
  "name": "@agentproof/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify API + browser-job manager. Orchestrates runs, persists to SQLite, streams progress to the dashboard.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agentproof/agent": "workspace:*",
    "@agentproof/diagnostics": "workspace:*",
    "@agentproof/shared": "workspace:*",
    "@agentproof/verifier": "workspace:*",
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
